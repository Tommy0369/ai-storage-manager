    "entity.generic.symlink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A symbolic link. The map does not follow it, so bytes are not duplicated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンボリックリンクです。地図は追跡しないので、容量は二重計上しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符号链接。地图不会跟随它，因此不会重复计算容量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符號連結。地圖不會跟隨它，因此不會重複計算容量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심볼릭 링크입니다. 맵이 따라가지 않아 용량을 중복 계산하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace simbólico. El mapa no lo sigue, así que no duplica bytes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien symbolique. La carte ne le suit pas, donc les octets ne sont pas dupliqués."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein symbolischer Link. Die Karte folgt ihm nicht — Bytes werden nicht doppelt gezählt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link simbólico. O mapa não o segue, então os bytes não são duplicados."
          }
        }
      }
    },
    "entity.generic.aggregate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaller items grouped so the map stays readable. The underlying folders remain discoverable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
