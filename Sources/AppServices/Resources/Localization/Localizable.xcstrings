    "detail.ollamaSharedNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some model files may be shared by multiple models. AI Storage Manager checks those relationships before recommending cleanup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のモデルファイルは複数モデルで共有されることがあります。整理を勧める前に、その関係を確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分模型文件可能被多个模型共享。在建议清理前，本应用会检查这些关系。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分模型檔案可能被多個模型共用。在建議清理前，本 App 會檢查這些關係。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 모델 파일은 여러 모델이 공유할 수 있습니다. 정리를 권하기 전에 그 관계를 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos de modelo pueden compartirse. Se comprueban esas relaciones antes de recomendar limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers de modèle peuvent être partagés. Ces relations sont vérifiées avant toute recommandation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Modelldateien können geteilt sein. Beziehungen werden vor einer Empfehlung geprüft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos de modelo podem ser compartilhados. Essas relações são verificadas antes de recomendar limpeza."
          }
        }
      }
    },
    "detail.hfRedownloadNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need to verify whether these models can be downloaded again before recommending cleanup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "整理を勧める前に、これらのモデルを再ダウンロードできるか確認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在建议清理前，需要确认这些模型是否可以重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在建議清理前，需要確認這些模型是否可以重新下載。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리를 권하기 전에 이 모델을 다시 다운로드할 수 있는지 확인해야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que verificar si estos modelos se pueden volver a descargar antes de recomendar limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut vérifier si ces modèles peuvent être retéléchargés avant de recommander un nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor einer Empfehlung muss geprüft werden, ob diese Modelle erneut heruntergeladen werden können."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso verificar se esses modelos podem ser baixados de novo antes de recomendar limpeza."
          }
        }
      }
    },
