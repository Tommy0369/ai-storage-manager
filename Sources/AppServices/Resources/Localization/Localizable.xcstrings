    "entity.chrome.keepReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect website and app state; do not treat the whole profile as cache."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトとアプリの状態を守ります。プロファイル全体をキャッシュ扱いしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护网站与应用状态；不要把整个配置文件当作缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護網站與 App 狀態；不要把整個設定檔當作快取。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트와 앱 상태를 보호합니다. 프로필 전체를 캐시로 취급하지 마세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja el estado de sitios y apps; no trate todo el perfil como caché."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez l’état des sites et apps ; ne traitez pas tout le profil comme cache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Website- und App-Zustand schützen; das gesamte Profil nicht als Cache behandeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja o estado de sites e apps; não trate o perfil inteiro como cache."
          }
        }
      }
    },
