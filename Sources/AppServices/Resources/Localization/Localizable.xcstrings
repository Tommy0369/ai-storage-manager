    },
    "entity.why.developer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build artifacts, simulators, and package caches accumulate over time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルド成果物、シミュレータ、パッケージキャッシュは時間とともに増えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建产物、模拟器和软件包缓存会随时间累积。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置產物、模擬器與套件快取會隨時間累積。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 산출물, 시뮬레이터, 패키지 캐시는 시간이 지나며 쌓입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefactos de build, simuladores y cachés de paquetes se acumulan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les artefacts de build, simulateurs et caches de paquets s’accumulent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-Artefakte, Simulatoren und Paket-Caches wachsen mit der Zeit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefatos de build, simuladores e caches de pacotes acumulam com o tempo."
          }
        }
      }
    },
    "entity.why.backups": {
