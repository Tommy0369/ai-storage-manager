    "common.firstRunPromise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what's using your Mac. Understand what it is. Only act when it's safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの容量の使い道を見る。何かを理解する。安全なときだけ動く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看 Mac 的空间用在哪里。理解它是什么。只有安全时才行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看 Mac 的空間用在哪裡。理解它是什麼。只有安全時才行動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 무엇을 쓰는지 보고, 무엇인지 이해한 뒤, 안전할 때만 행동하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea qué usa su Mac. Entienda qué es. Actúe solo cuando sea seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce qui utilise votre Mac. Comprenez ce que c’est. Agissez seulement si c’est sûr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie, was Speicher belegt. Verstehen Sie, was es ist. Handeln Sie nur, wenn es sicher ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que usa seu Mac. Entenda o que é. Só aja quando for seguro."
          }
        }
      }
    },
