    "permission.fullDiskAccess.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Storage Manager can map more of your Mac if you allow Full Disk Access. Without it, the app still works on what is visible — inaccessible areas stay unknown, never empty or safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスを許可すると、AI Storage Manager は Mac のより広い範囲を地図化できます。許可しなくても見える範囲では動作し、見えない領域は未知のままです（空でも安全でもありません）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果允许“完全磁盘访问权限”，AI Storage Manager 可以绘制更多 Mac 存储地图。即使不授权，应用仍可处理可见内容——无法访问的区域保持未知，绝不会被当作空或安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果允許「完全磁碟存取」，AI Storage Manager 可以繪製更多 Mac 儲存地圖。即使不授權，App 仍可處理可見內容——無法存取的區域保持未知，絕不會被視為空或安全。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근을 허용하면 AI Storage Manager가 Mac을 더 넓게 매핑할 수 있습니다. 허용하지 않아도 보이는 범위에서는 동작하며, 접근할 수 없는 영역은 알 수 없음으로 남고 비어 있거나 안전하다고 취급되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Storage Manager puede mapear más de su Mac si permite Acceso completo al disco. Sin él, la app sigue funcionando con lo visible: las zonas inaccesibles permanecen desconocidas, nunca vacías ni seguras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Storage Manager peut cartographier davantage votre Mac si vous autorisez l’accès complet au disque. Sans cela, l’app fonctionne toujours sur le visible — les zones inaccessibles restent inconnues, jamais vides ni sûres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Storage Manager kann mehr von Ihrem Mac kartieren, wenn Sie Vollen Festplattenzugriff erlauben. Ohne diesen funktioniert die App weiterhin mit dem Sichtbaren — unzugängliche Bereiche bleiben unbekannt, nie leer oder sicher."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AI Storage Manager pode mapear mais do seu Mac se você permitir Acesso Total ao Disco. Sem isso, o app ainda funciona com o que é visível — áreas inacessíveis permanecem desconhecidas, nunca vazias ou seguras."
          }
        }
      }
    },
    "permission.limitedVisibility.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limited visibility is OK. Unknown regions stay Unknown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見える範囲が限られても大丈夫です。未知は未知のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可见范围有限也没关系。未知区域保持未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可見範圍有限也沒關係。未知區域保持未知。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이는 범위가 제한되어도 괜찮습니다. 알 수 없는 영역은 알 수 없음으로 남습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilidad limitada está bien. Las regiones desconocidas siguen desconocidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une visibilité limitée convient. Les zones inconnues restent inconnues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschränkte Sicht ist in Ordnung. Unbekannte Bereiche bleiben unbekannt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibilidade limitada está ok. Regiões desconhecidas permanecem desconhecidas."
          }
        }
      }
    },
