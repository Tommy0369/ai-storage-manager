    "entity.chrome.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser & website data — site state plus some verified cache."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザとサイトのデータ — サイト状態と一部の検証済みキャッシュ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器与网站数据 — 站点状态加上部分已验证缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器與網站資料 — 網站狀態加上部分已驗證快取。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 및 웹사이트 데이터 — 사이트 상태와 일부 검증된 캐시."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos del navegador y sitios — estado del sitio más algo de caché verificada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données navigateur et sites — état des sites plus un cache vérifié partiel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser- und Website-Daten — Site-Zustand plus etwas verifizierten Cache."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados do navegador e sites — estado do site mais algum cache verificado."
          }
        }
      }
    },
