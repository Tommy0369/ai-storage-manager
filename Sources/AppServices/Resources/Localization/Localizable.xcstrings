    "entity.protect.voiceMemos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep — these are your original recordings. Deleting can sync across Apple devices, and Apple doesn’t expose a verified local-only offload for Voice Memos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す — あなた自身のオリジナル録音です。削除はAppleデバイス間で同期され得ます。Voice Memos向けの検証済みローカルのみ退避は提供されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — 这些是您的原始录音。删除可能在 Apple 设备间同步，且 Apple 未提供经核实的仅本地卸载方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — 這些是您的原始錄音。刪除可能在 Apple 裝置間同步，且 Apple 未提供經驗證的僅本機卸載方式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 — 원본 녹음입니다. 삭제는 Apple 기기 간에 동기화될 수 있으며, Voice Memos용 검증된 로컬 전용 오프로드는 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar — son sus grabaciones originales. Borrar puede sincronizarse entre dispositivos Apple, y Apple no ofrece una descarga solo local verificada para Notas de Voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver — ce sont vos enregistrements originaux. La suppression peut se synchroniser entre appareils Apple, et Apple n’expose pas de déchargement local vérifié pour Mémos vocaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten — das sind Ihre Originalaufnahmen. Löschen kann auf Apple-Geräten synchronisieren; Apple bietet kein verifiziertes nur-lokales Auslagern für Sprachnotizen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter — estas são suas gravações originais. Excluir pode sincronizar entre dispositivos Apple, e a Apple não oferece remoção apenas local verificada para Memorando de Voz."
          }
        }
      }
    },
    "entity.protect.iosBackup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep — this is a local device backup. Moving this folder directly may make the backup unusable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す — ローカルのデバイスバックアップです。このフォルダを直接動かすとバックアップが使えなくなることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — 这是本地设备备份。直接移动此文件夹可能导致备份无法使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — 這是本機裝置備份。直接移動此資料夾可能使備份無法使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 — 로컬 기기 백업입니다. 이 폴더를 직접 옮기면 백업을 쓸 수 없게 될 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar — es una copia local del dispositivo. Mover esta carpeta directamente puede inutilizar la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver — c’est une sauvegarde locale d’appareil. Déplacer ce dossier directement peut rendre la sauvegarde inutilisable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten — dies ist ein lokales Geräte-Backup. Direkter Ordnerzugriff kann das Backup unbrauchbar machen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter — este é um backup local do dispositivo. Mover esta pasta diretamente pode inutilizar o backup."
          }
        }
      }
    },
    "entity.protect.git": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep — Git repository data requires relocation contracts. Bulk delete is blocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す — Gitリポジトリデータは移設契約が必要です。一括削除は遮断されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — Git 仓库数据需要迁移约定。批量删除已阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — Git 儲存庫資料需要遷移約定。大量刪除已阻擋。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 — Git 저장소 데이터는 이전 계약이 필요합니다. 대량 삭제는 차단됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar — los datos de Git requieren contratos de reubicación. El borrado masivo está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver — les données Git exigent des contrats de relocation. La suppression en masse est bloquée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten — Git-Repository-Daten brauchen Umzugsverträge. Massenlöschen ist gesperrt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter — dados de repositório Git exigem contratos de relocação. Exclusão em massa está bloqueada."
          }
        }
      }
    },
    "entity.protect.claude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep — Claude’s runtime includes a base system and mutable session state. Active runtimes stay protected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す — Claudeのランタイムは基盤と変更可能なセッション状態を含みます。稼働中は保護されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — Claude 运行时包含基础系统与可变会话状态。活动运行时保持受保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — Claude 執行階段包含基礎系統與可變工作階段狀態。活動執行階段維持受保護。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 — Claude 런타임은 기반 시스템과 변경 가능한 세션 상태를 포함합니다. 활성 런타임은 보호됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar — el runtime de Claude incluye un sistema base y estado de sesión mutable. Los runtimes activos quedan protegidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver — le runtime Claude inclut un système de base et un état de session mutable. Les runtimes actifs restent protégés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten — Claudes Runtime umfasst Basis und veränderlichen Sitzungszustand. Aktive Runtimes bleiben geschützt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter — o runtime do Claude inclui sistema base e estado de sessão mutável. Runtimes ativos permanecem protegidos."
          }
        }
      }
    },
    "entity.protect.chrome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep site and app data protected. Browser “cache” names alone aren’t enough to treat this as disposable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトとアプリのデータを保護します。ブラウザの「キャッシュ」という名前だけでは捨ててよいと判断しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护网站与应用数据。仅凭浏览器“缓存”名称不足以视为可丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護網站與 App 資料。僅憑瀏覽器「快取」名稱不足以視為可丟棄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트와 앱 데이터를 보호합니다. 브라우저 ‘캐시’라는 이름만으로 버려도 된다고 보지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga protegidos los datos de sitios y apps. El nombre “caché” del navegador no basta para tratarlos como desechables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez protégées les données de sites et d’apps. Le seul nom « cache » du navigateur ne suffit pas à les traiter comme jetables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Website- und App-Daten geschützt halten. Der bloße Browser-Name „Cache“ reicht nicht aus, sie als entbehrlich zu behandeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha protegidos os dados de sites e apps. O nome “cache” do navegador sozinho não basta para tratá-los como descartáveis."
          }
        }
      }
    },
    "entity.protect.cursor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep — Cursor uses this state to restore your work. Cleanup isn’t available for this store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残す — Cursorはこの状態で作業を復元します。このストアのクリーンアップはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — Cursor 用此状态恢复您的工作。此存储不提供清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 — Cursor 用此狀態還原您的工作。此存放區不提供清理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 — Cursor가 이 상태로 작업을 복원합니다. 이 저장소에는 정리 기능이 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar — Cursor usa este estado para restaurar su trabajo. No hay limpieza para este almacén."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver — Cursor utilise cet état pour restaurer votre travail. Aucun nettoyage n’est disponible pour ce magasin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten — Cursor nutzt diesen Zustand, um Ihre Arbeit wiederherzustellen. Für diesen Speicher gibt es keine Bereinigung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter — o Cursor usa este estado para restaurar seu trabalho. Não há limpeza para este armazenamento."
          }
        }
      }
    },
