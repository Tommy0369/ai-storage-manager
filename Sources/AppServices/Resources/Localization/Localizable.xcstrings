    "entity.voiceMemos.block": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple does not provide a verified local-only removal action for these recordings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleは、これらの録音向けに検証済みのローカルのみ削除手段を提供していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未提供经核实的、仅删除本地副本的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未提供經驗證的、僅刪除本機副本的操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple은 이 녹음에 대해 검증된 로컬 전용 제거 동작을 제공하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ofrece una acción verificada de eliminación solo local para estas grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ne fournit pas d’action vérifiée de suppression locale seule pour ces enregistrements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bietet keine verifizierte nur-lokale Entfernung für diese Aufnahmen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não fornece uma ação verificada de remoção apenas local para estas gravações."
          }
        }
      }
    },
