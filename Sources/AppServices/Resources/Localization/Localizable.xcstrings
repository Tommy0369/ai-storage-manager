    "plan.diskRecoveryLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk recovery happens after Trash is emptied — Empty Trash is not offered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク容量の回復はゴミ箱を空にしたあとになります。空にする操作は提供しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间要在清空废纸篓之后才会回收——应用不会提供“清空废纸篓”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟空間要在清空垃圾桶之後才會回收——App 不會提供「清空垃圾桶」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 공간 회수는 휴지통을 비운 뒤에 이뤄집니다. 비우기 기능은 제공하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación de disco ocurre al vaciar la Papelera — no se ofrece Vaciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération d’espace a lieu après le vidage de la Corbeille — non proposé ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher wird erst nach dem Leeren des Papierkorbs frei — Leeren wird nicht angeboten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação de disco ocorre após esvaziar o Lixo — Esvaziar não é oferecido."
          }
        }
      }
    },
